# PDFShield runtime configuration
# SQLite is the default requested storage mode. Set true only after wiring the managed connector.
PDFSHIELD_USE_MANAGED_DB=false
DATABASE_URL=sqlite:///./pdfshield.db
PDFSHIELD_MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000
# Optional server-side provider keys; never place these in frontend code.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
